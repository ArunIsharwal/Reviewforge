# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# MongoDB Connection
# Set to your MongoDB Atlas cluster URI or local MongoDB URI
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/reviewforge?retryWrites=true&w=majority
MONGODB_DB_NAME=reviewforge

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_key_at_least_32_characters_long
REFRESH_TOKEN_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ENABLED=true
GEMINI_ALLOW_REAL_EMPLOYEE_DATA=false

# Initial System Administrator Seed
SEED_ADMIN_NAME="ReviewForge Admin"
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=Admin@123

